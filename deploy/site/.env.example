# Copy to deploy/site/.env on the server and fill in; never commit the real file.

# Compose project name.
EIRORA_SITE_PROJECT=eirora-site

# Public host name for the pages; the privacy policy is https://<host>/privacy/.
EIRORA_SITE_HOST=

# Shown on the pages: the developer name from Google Play and the public privacy contact address.
EIRORA_DEVELOPER_NAME=
EIRORA_PRIVACY_CONTACT=

# Traefik on the server: the external network, the HTTPS entry point and the Let's Encrypt resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
