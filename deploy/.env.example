# Copy to deploy/.env on the server and fill in; never commit the real file.

# Compose project name: eirora for production, eirora-staging for staging (own database, keys and host).
EIRORA_PROJECT=eirora

# Image tag: the commit sha CI published to ghcr.io/tiico/eirora-server.
EIRORA_VERSION=

# Public host name Traefik serves the API on.
EIRORA_HOST=

# Traefik on the server: the external network, the HTTPS entry point and the Let's Encrypt resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Sign in with Apple: the app's bundle id (iOS), the Services ID (Android web flow), team and key id of the .p8 key.
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Google sign-in: the web ("server") client id Android and the deletion page request ID tokens for, and the iOS client id.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# The Android app that receives Sign in with Apple's answer (the default is the app's application id).
ANDROID_PACKAGE=se.eirora.app
