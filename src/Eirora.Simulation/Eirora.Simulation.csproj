<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The engine-agnostic simulation core (ADR-0002).
    Also a local Unity package (package.json, Eirora.Simulation.asmdef): Unity compiles these same sources.
    It must never reference Unity or any other package.
  -->
  <PropertyGroup>
    <!-- Unity's compiler builds these sources too: netstandard2.1 and C# 9, so no implicit usings (C# 10). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Eirora.Simulation</RootNamespace>
  </PropertyGroup>
</Project>
