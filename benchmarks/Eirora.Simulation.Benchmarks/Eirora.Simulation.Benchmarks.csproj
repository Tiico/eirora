<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Benchmarks for the simulation, run by hand in Release (see docs/development.md).
    CI builds them so they keep compiling, but does not run them: timings on shared runners are too noisy to gate on.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eirora.Simulation\Eirora.Simulation.csproj" />
  </ItemGroup>
</Project>
