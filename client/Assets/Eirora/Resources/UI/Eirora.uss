/* Gränssnittet i riktning A: ljusa paneler, mörk text (art-direction.md, section 3). Sizes are reference pixels at 1080 wide. */

.screen {
    flex-grow: 1;
    justify-content: space-between;
    padding: 36px 32px 40px 32px;
}

.card {
    background-color: rgba(251, 247, 239, 0.94);
    border-radius: 34px;
    padding: 26px 32px;
    border-color: rgba(43, 42, 51, 0.08);
    border-width: 2px;
    color: rgb(43, 42, 51);
}

/* The forces along the horizon (ui-prototypes.html, direction C): a translucent strip whose three fields grow with
   the amounts, each with the force's shape, its amount and a line in its colour. */
.horizon {
    flex-direction: row;
    height: 84px;
    border-radius: 42px;
    overflow: hidden;
    background-color: rgba(16, 24, 48, 0.42);
}

.segment {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-basis: 0;
    min-width: 200px;
    padding: 0 20px;
    border-bottom-width: 10px;
}

.segment-value {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-left: 12px;
}

/* The rail at the left: round signs for self-care, the queue, the report and the account, and the villagers' pips. */
.rail {
    position: absolute;
    left: 0;
    top: 24px;
    flex-direction: column;
    align-items: center;
}

.rail-button {
    width: 132px;
    height: 132px;
    margin: 0 0 20px 0;
    padding: 0;
    border-radius: 66px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    background-color: rgba(251, 247, 239, 0.96);
    align-items: center;
    justify-content: center;
}

.rail-button:active {
    background-color: rgb(241, 233, 220);
}

.badge {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 54px;
    height: 54px;
    padding: 0 14px;
    border-radius: 27px;
    border-width: 4px;
    border-color: rgb(251, 247, 239);
    background-color: rgb(43, 42, 51);
    color: rgb(251, 247, 239);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.folk {
    align-items: center;
    margin-top: 8px;
}

.pips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 132px;
    margin-top: 6px;
}

.pip {
    width: 18px;
    height: 28px;
    margin: 2px;
    border-radius: 7px 7px 5px 5px;
    background-color: rgb(255, 255, 255);
}

.pip-empty {
    background-color: rgba(0, 0, 0, 0);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

/* What lives on the island: the layer under the screen whose children follow the camera (Hud.World.cs). */
.island-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bubbles {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bubble {
    position: absolute;
    width: 96px;
    height: 96px;
    margin: 0;
    padding: 0;
    border-radius: 48px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.12);
    background-color: rgb(251, 247, 239);
    align-items: center;
    justify-content: center;
}

.bubble:active {
    background-color: rgb(241, 233, 220);
}

.bubble-tail {
    position: absolute;
    bottom: -9px;
    left: 36px;
    width: 22px;
    height: 22px;
    rotate: 45deg;
    background-color: rgb(251, 247, 239);
}

.bubble-wide {
    width: auto;
    flex-direction: row;
    padding: 0 14px;
    border-radius: 42px;
}

.shelf {
    flex-direction: row;
    align-items: flex-end;
}

.stock {
    align-items: center;
    margin: 0 6px;
}

.stock-bar {
    width: 18px;
    height: 44px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: rgba(43, 42, 51, 0.12);
    overflow: hidden;
    justify-content: flex-end;
}

.stock-fill {
    width: 100%;
    border-radius: 6px;
    background-color: rgba(43, 42, 51, 0.75);
}

.progress-ring {
    position: absolute;
    left: -10px;
    top: -10px;
    right: -10px;
    bottom: -10px;
}

/* The compass in the fog, which the next survey lifts, with its cost. */
.compass {
    position: absolute;
    width: 150px;
    height: 150px;
    margin: 0;
    padding: 0;
    border-radius: 75px;
    border-width: 0;
    background-color: rgba(251, 247, 239, 0.92);
    align-items: center;
    justify-content: center;
}

.compass > .chip {
    position: absolute;
    bottom: -16px;
    right: -12px;
}

/* The late carrier, on the way from a building whose goods wait to its depot (TASK-043). */
.late {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 6px;
    border-color: rgb(180, 71, 58);
    background-color: rgb(251, 247, 239);
    align-items: center;
    justify-content: center;
}

.late-clock {
    position: absolute;
    top: -16px;
    right: -16px;
}

/* The ring of choices around the selected tile: a round picture or sign each, its cost as chips under it, and the
   words of the chosen one on a caption below the ring. */
.ring {
    position: absolute;
    width: 0;
    height: 0;
}

.ring-centre {
    position: absolute;
    left: -45px;
    top: -45px;
    width: 90px;
    height: 90px;
    margin: 0;
    padding: 0;
    border-radius: 45px;
    border-width: 0;
    background-color: rgba(251, 247, 239, 0.9);
    color: rgb(43, 42, 51);
    font-size: 44px;
    -unity-text-align: middle-center;
}

.choice {
    position: absolute;
    width: 156px;
    height: 156px;
    margin: 0;
    padding: 0;
    border-radius: 78px;
    border-width: 3px;
    border-color: rgba(43, 42, 51, 0.12);
    background-color: rgb(251, 247, 239);
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.choice:active {
    background-color: rgb(241, 233, 220);
}

.choice-chosen {
    border-width: 6px;
    border-color: rgb(43, 42, 51);
}

.choice-unavailable > .choice-picture,
.choice-unavailable > .glyph,
.choice-unavailable > .force-icon {
    opacity: 0.4;
}

.choice-picture {
    width: 136px;
    height: 136px;
    -unity-background-scale-mode: scale-to-fit;
}

.choice-chips {
    position: absolute;
    bottom: -26px;
    flex-direction: row;
    justify-content: center;
}

.chip {
    flex-direction: row;
    align-items: center;
    height: 48px;
    margin: 0 3px;
    padding: 0 12px 0 6px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.12);
    background-color: rgb(251, 247, 239);
}

.chip-lack {
    border-width: 4px;
    border-color: rgb(180, 71, 58);
    background-color: rgb(246, 226, 222);
}

.chip-amount {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
    margin-left: 4px;
}

.caption {
    position: absolute;
    left: -380px;
    width: 760px;
    padding: 18px 28px;
    border-radius: 30px;
    background-color: rgba(251, 247, 239, 0.96);
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.08);
}

.caption-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
    white-space: normal;
}

.caption-text {
    font-size: 29px;
    color: rgb(104, 101, 117);
    white-space: normal;
    margin-top: 4px;
}

.caption-hint {
    font-size: 27px;
    color: rgb(104, 101, 117);
    -unity-font-style: italic;
    margin-top: 8px;
}

.bottom {
    flex-direction: column;
}

.bar {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.button {
    flex-grow: 1;
    flex-basis: 0;
    height: 120px;
    margin: 0 8px;
    border-radius: 30px;
    background-color: rgba(251, 247, 239, 0.96);
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    color: rgb(43, 42, 51);
    font-size: 31px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.button:hover {
    background-color: rgb(255, 252, 245);
}

.button:active {
    background-color: rgb(241, 233, 220);
}

.button:disabled {
    opacity: 0.45;
}

.button-wide {
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
    height: 120px;
    margin: 18px 0 0 0;
}

.button-primary {
    background-color: rgb(180, 71, 58);
    color: rgb(251, 247, 239);
    border-color: rgb(160, 60, 49);
}

.button-primary:active {
    background-color: rgb(160, 60, 49);
}

.sheet {
    margin-bottom: 4px;
}

.sheet-title {
    font-size: 46px;
    -unity-font-style: bold;
}

.sheet-subtitle {
    font-size: 30px;
    color: rgb(104, 101, 117);
    margin-top: 4px;
    margin-bottom: 14px;
}

/* The subtitle of a building's sheet, after the sign it shares with the island when it stands still (TASK-043). */
.sheet-status {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 14px;
}

.sheet-status > .sheet-subtitle {
    margin: 0;
    flex-shrink: 1;
    white-space: normal;
}

.standing-still {
    flex-shrink: 0;
    margin-right: 12px;
}

.sheet-text {
    font-size: 32px;
    white-space: normal;
    margin-bottom: 10px;
}

.action {
    flex-direction: column;
    align-items: stretch;
    margin: 8px 0;
    padding: 18px 26px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    background-color: rgb(255, 252, 245);
    -unity-text-align: middle-left;
}

.action:active {
    background-color: rgb(241, 233, 220);
}

.action-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
}

.action-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.action-effect {
    flex-shrink: 1;
    margin-left: 20px;
    font-size: 27px;
    color: rgb(43, 42, 51);
    white-space: normal;
    -unity-text-align: middle-right;
}

.action-cost {
    font-size: 27px;
    color: rgb(104, 101, 117);
    white-space: normal;
}

.action-unavailable {
    opacity: 0.5;
}

/* A project in the building queue: what it makes and its work left, and a button to move it first (TASK-044). */
.queue-item {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
    padding: 16px 18px 16px 26px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    background-color: rgb(255, 252, 245);
}

.queue-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.queue-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
}

.queue-detail {
    font-size: 27px;
    color: rgb(104, 101, 117);
}

.queue-button {
    flex-shrink: 0;
    height: 84px;
    margin: 0 0 0 20px;
    padding: 0 34px;
    border-radius: 42px;
    border-width: 0;
    background-color: rgba(43, 42, 51, 0.06);
    color: rgb(43, 42, 51);
    font-size: 31px;
    -unity-font-style: bold;
}

/* A good in an island's store, in the order the ships take them home, with a button to move it first (TASK-046). */
.good {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
    padding: 6px 10px 6px 26px;
    min-height: 76px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    background-color: rgb(255, 252, 245);
}

/* The good whose reservation the stepper below sets. */
.good-chosen {
    border-color: rgb(43, 42, 51);
}

/* The good's name and stock, which choose it. */
.good-pick {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.good-pick:hover,
.good-pick:active {
    background-color: rgba(0, 0, 0, 0);
}

.good-name {
    min-width: 170px;
    -unity-text-align: middle-left;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
}

.good-detail {
    flex-shrink: 1;
    -unity-text-align: middle-left;
    font-size: 27px;
    color: rgb(104, 101, 117);
}

.good-button {
    flex-shrink: 0;
    height: 62px;
    margin: 0 0 0 20px;
    padding: 0 30px;
    border-radius: 34px;
    border-width: 0;
    background-color: rgba(43, 42, 51, 0.06);
    color: rgb(43, 42, 51);
    font-size: 29px;
    -unity-font-style: bold;
}

.close {
    position: absolute;
    right: 18px;
    top: 14px;
    width: 76px;
    height: 76px;
    border-radius: 38px;
    font-size: 40px;
    background-color: rgba(43, 42, 51, 0.06);
    border-width: 0;
    color: rgb(43, 42, 51);
}

/* Demolition beside the close button on a building's sheet, so that it makes no sheet taller (TASK-047). */
.sheet-demolish {
    position: absolute;
    right: 106px;
    top: 14px;
    height: 76px;
    padding: 0 28px;
    border-radius: 38px;
    font-size: 30px;
    -unity-font-style: bold;
    background-color: rgba(43, 42, 51, 0.06);
    border-width: 0;
    color: rgb(180, 71, 58);
}

.sheet-demolish:active {
    background-color: rgba(43, 42, 51, 0.12);
}

/* The night (RST-03): an arc from the moon to the sun along the top, with how far the rest has come and when the
   world opens. Nothing else is said; the island with its lit windows is the night's card. */
.night-arc {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    align-items: center;
}

.arc {
    width: 760px;
    height: 330px;
}

.night-time {
    position: absolute;
    top: 196px;
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(255, 210, 122);
}

.toast {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 330px;
    padding: 24px 30px;
    border-radius: 30px;
    background-color: rgba(43, 42, 51, 0.92);
    color: rgb(251, 247, 239);
    font-size: 31px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 10px 0;
}

.row-label {
    font-size: 34px;
    flex-grow: 1;
}

/* A row's name with a line under it, such as what the minimum stock keeps (TASK-046). */
.row-title {
    font-size: 34px;
}

.row-detail {
    font-size: 27px;
    color: rgb(104, 101, 117);
    white-space: normal;
}

.stepper {
    flex-direction: row;
    align-items: center;
}

.stepper-button {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    font-size: 44px;
    margin: 0 6px;
    background-color: rgb(255, 252, 245);
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.12);
    color: rgb(43, 42, 51);
}

.stepper-value {
    min-width: 210px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tabs {
    flex-direction: row;
    margin-bottom: 14px;
}

.tab {
    flex-grow: 1;
    height: 88px;
    border-radius: 24px;
    font-size: 31px;
    margin: 0 6px;
    background-color: rgba(43, 42, 51, 0.05);
    border-width: 0;
    color: rgb(43, 42, 51);
}

.tab-selected {
    background-color: rgb(43, 42, 51);
    color: rgb(251, 247, 239);
}

.link {
    color: rgb(180, 71, 58);
    -unity-font-style: bold;
}

.report-line {
    font-size: 32px;
    white-space: normal;
    margin: 6px 0;
}

/* Which build is running, for the prototype diary (TASK-014). */
.build {
    font-size: 22px;
    color: rgb(104, 101, 117);
    margin-top: 18px;
    -unity-text-align: middle-center;
}

.setup {
    margin-top: 180px;
}

.recovery-code {
    font-size: 40px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.recovery-code-field {
    height: 100px;
    margin-bottom: 14px;
}

.qr-code {
    width: 560px;
    height: 560px;
    align-self: center;
    margin: 18px 0;
    background-color: rgb(255, 255, 255);
}

.camera-frame {
    width: 560px;
    height: 560px;
    align-self: center;
    margin: 18px 0;
    border-radius: 24px;
    overflow: hidden;
    background-color: rgb(43, 42, 51);
}

.camera-preview {
    width: 100%;
    height: 100%;
}

.check-code {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.introduction {
    margin-top: 160px;
}

.introduction-title {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(180, 71, 58);
    white-space: normal;
    margin-bottom: 12px;
}

.setup-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(180, 71, 58);
    white-space: normal;
}
