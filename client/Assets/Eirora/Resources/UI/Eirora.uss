/* Gränssnittet i riktning A: ljusa paneler, mörk text (art-direction.md, section 3). Sizes are reference pixels at 1080 wide. */

.screen {
    flex-grow: 1;
    justify-content: space-between;
    padding: 36px 32px 40px 32px;
}

.card {
    background-color: rgba(251, 247, 239, 0.94);
    border-radius: 34px;
    padding: 26px 32px;
    border-color: rgba(43, 42, 51, 0.08);
    border-width: 2px;
    color: rgb(43, 42, 51);
}

.top {
    flex-direction: column;
}

.forces {
    flex-direction: row;
    justify-content: space-between;
}

.force {
    flex-direction: row;
    align-items: center;
}

.force-value {
    font-size: 54px;
    -unity-font-style: bold;
    margin-left: 12px;
}

.force-name {
    font-size: 26px;
    color: rgb(104, 101, 117);
    margin-left: 10px;
    margin-top: 10px;
}

/* One label per resource, spread over the card with at least a small gap. The row's negative right margin takes back
   the last label's gap, its left margin lines it up with the status below, whose label keeps its padding, and it
   wraps only when the stock no longer fits on one line. */
.resources {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 18px -12px 0 2px;
}

.resource {
    font-size: 30px;
    margin: 0 12px 0 0;
    padding: 0;
    color: rgb(68, 66, 80);
}

.status {
    font-size: 30px;
    color: rgb(104, 101, 117);
    margin-top: 12px;
    white-space: normal;
}

.bottom {
    flex-direction: column;
}

.bar {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.button {
    flex-grow: 1;
    flex-basis: 0;
    height: 120px;
    margin: 0 8px;
    border-radius: 30px;
    background-color: rgba(251, 247, 239, 0.96);
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    color: rgb(43, 42, 51);
    font-size: 31px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.button:hover {
    background-color: rgb(255, 252, 245);
}

.button:active {
    background-color: rgb(241, 233, 220);
}

.button:disabled {
    opacity: 0.45;
}

.button-title {
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(43, 42, 51);
}

.button-cost {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 4px;
}

.button-cost-value {
    font-size: 27px;
    color: rgb(104, 101, 117);
    margin-left: 6px;
}

/* A bar button's second line that is not a cost, such as how long the building queue is. */
.button-detail {
    font-size: 27px;
    color: rgb(104, 101, 117);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* The account button at the end of the bar: a square with a person (ADR-0008). */
.button-icon {
    flex-grow: 0;
    flex-basis: 120px;
    width: 120px;
    align-items: center;
    justify-content: center;
}

.button-wide {
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
    height: 120px;
    margin: 18px 0 0 0;
}

.button-primary {
    background-color: rgb(180, 71, 58);
    color: rgb(251, 247, 239);
    border-color: rgb(160, 60, 49);
}

.button-primary:active {
    background-color: rgb(160, 60, 49);
}

.sheet {
    margin-bottom: 4px;
}

.sheet-title {
    font-size: 46px;
    -unity-font-style: bold;
}

.sheet-subtitle {
    font-size: 30px;
    color: rgb(104, 101, 117);
    margin-top: 4px;
    margin-bottom: 14px;
}

/* The subtitle of a building's sheet, after the sign it shares with the island when it stands still (TASK-043). */
.sheet-status {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 14px;
}

.sheet-status > .sheet-subtitle {
    margin: 0;
    flex-shrink: 1;
    white-space: normal;
}

.standing-still {
    flex-shrink: 0;
    margin-right: 12px;
}

.sheet-text {
    font-size: 32px;
    white-space: normal;
    margin-bottom: 10px;
}

.action {
    flex-direction: column;
    align-items: stretch;
    margin: 8px 0;
    padding: 18px 26px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    background-color: rgb(255, 252, 245);
    -unity-text-align: middle-left;
}

.action:active {
    background-color: rgb(241, 233, 220);
}

.action-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
}

.action-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.action-effect {
    flex-shrink: 1;
    margin-left: 20px;
    font-size: 27px;
    color: rgb(43, 42, 51);
    white-space: normal;
    -unity-text-align: middle-right;
}

.action-cost {
    font-size: 27px;
    color: rgb(104, 101, 117);
    white-space: normal;
}

.action-unavailable {
    opacity: 0.5;
}

/* A project in the building queue: what it makes and its work left, and a button to move it first (TASK-044). */
.queue-item {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
    padding: 16px 18px 16px 26px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.10);
    background-color: rgb(255, 252, 245);
}

.queue-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.queue-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(43, 42, 51);
}

.queue-detail {
    font-size: 27px;
    color: rgb(104, 101, 117);
}

.queue-button {
    flex-shrink: 0;
    height: 84px;
    margin: 0 0 0 20px;
    padding: 0 34px;
    border-radius: 42px;
    border-width: 0;
    background-color: rgba(43, 42, 51, 0.06);
    color: rgb(43, 42, 51);
    font-size: 31px;
    -unity-font-style: bold;
}

.close {
    position: absolute;
    right: 18px;
    top: 14px;
    width: 76px;
    height: 76px;
    border-radius: 38px;
    font-size: 40px;
    background-color: rgba(43, 42, 51, 0.06);
    border-width: 0;
    color: rgb(43, 42, 51);
}

/* Demolition beside the close button on a building's sheet, so that it makes no sheet taller (TASK-047). */
.sheet-demolish {
    position: absolute;
    right: 106px;
    top: 14px;
    height: 76px;
    padding: 0 28px;
    border-radius: 38px;
    font-size: 30px;
    -unity-font-style: bold;
    background-color: rgba(43, 42, 51, 0.06);
    border-width: 0;
    color: rgb(180, 71, 58);
}

.sheet-demolish:active {
    background-color: rgba(43, 42, 51, 0.12);
}

.night {
    background-color: rgba(16, 24, 48, 0.86);
    border-color: rgba(255, 210, 122, 0.25);
    color: rgb(232, 238, 248);
    align-items: center;
    margin-top: 40px;
}

.night-title {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(255, 210, 122);
}

.night-text {
    font-size: 34px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.toast {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 330px;
    padding: 24px 30px;
    border-radius: 30px;
    background-color: rgba(43, 42, 51, 0.92);
    color: rgb(251, 247, 239);
    font-size: 31px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 10px 0;
}

.row-label {
    font-size: 34px;
    flex-grow: 1;
}

.stepper {
    flex-direction: row;
    align-items: center;
}

.stepper-button {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    font-size: 44px;
    margin: 0 6px;
    background-color: rgb(255, 252, 245);
    border-width: 2px;
    border-color: rgba(43, 42, 51, 0.12);
    color: rgb(43, 42, 51);
}

.stepper-value {
    min-width: 210px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tabs {
    flex-direction: row;
    margin-bottom: 14px;
}

.tab {
    flex-grow: 1;
    height: 88px;
    border-radius: 24px;
    font-size: 31px;
    margin: 0 6px;
    background-color: rgba(43, 42, 51, 0.05);
    border-width: 0;
    color: rgb(43, 42, 51);
}

.tab-selected {
    background-color: rgb(43, 42, 51);
    color: rgb(251, 247, 239);
}

.link {
    color: rgb(180, 71, 58);
    -unity-font-style: bold;
}

.report-line {
    font-size: 32px;
    white-space: normal;
    margin: 6px 0;
}

/* Which build is running, for the prototype diary (TASK-014). */
.build {
    font-size: 22px;
    color: rgb(104, 101, 117);
    margin-top: 18px;
    -unity-text-align: middle-center;
}

.setup {
    margin-top: 180px;
}

.recovery-code {
    font-size: 40px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.recovery-code-field {
    height: 100px;
    margin-bottom: 14px;
}

.qr-code {
    width: 560px;
    height: 560px;
    align-self: center;
    margin: 18px 0;
    background-color: rgb(255, 255, 255);
}

.camera-frame {
    width: 560px;
    height: 560px;
    align-self: center;
    margin: 18px 0;
    border-radius: 24px;
    overflow: hidden;
    background-color: rgb(43, 42, 51);
}

.camera-preview {
    width: 100%;
    height: 100%;
}

.check-code {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.setup-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(180, 71, 58);
}
