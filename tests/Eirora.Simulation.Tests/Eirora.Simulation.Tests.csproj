<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Every method compiled optimized at once, as IL2CPP does on the phone: the timed fast-forward (FastForwardTests)
         measures optimized code from the start, and the long-running properties are faster. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eirora.Contracts\Eirora.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Eirora.Simulation\Eirora.Simulation.csproj" />
    <ProjectReference Include="..\..\src\Eirora.WorldGeneration\Eirora.WorldGeneration.csproj" />
  </ItemGroup>
</Project>
